{
  "name": "e-commerce-back-end",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "server": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "postinstall": "prisma generate",
    "db": "prisma dev",
    "start-all": "concurrently \"npm run db\" \"wait-on tcp:51213 && npm run server\""
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "dotenv": "^16.4.7",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "wait-on": "^9.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
